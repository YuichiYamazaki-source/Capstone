        <mxCell id="f2b" edge="1" parent="1" source="fe-onboarding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="gw-skills">
          <mxGeometry relative="1" as="geometry" />

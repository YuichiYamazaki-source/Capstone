        <mxCell id="user-svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=13;fontColor=#000000;fontStyle=1;" value="User Service :8002&lt;br&gt;&lt;font style=&quot;font-weight:normal;font-size:10px&quot;&gt;Auth + Profile CRUD&lt;br&gt;MongoDB users collection&lt;/font&gt;" vertex="1">
          <mxGeometry x="720" y="120" width="220" height="60" as="geometry" />

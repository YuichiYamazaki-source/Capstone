          <mxGeometry x="380" y="510" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-sg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#000000;align=left;spacingLeft=8;" value="&lt;b&gt;POST&lt;/b&gt; /analyze/skill-gap" vertex="1">
          <mxGeometry x="380" y="545" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-career" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#000000;align=left;spacingLeft=8;" value="&lt;b&gt;POST&lt;/b&gt; /analyze/career" vertex="1">
          <mxGeometry x="380" y="580" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-lp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#000000;align=left;spacingLeft=8;" value="&lt;b&gt;POST&lt;/b&gt; /analyze/learning-path" vertex="1">
          <mxGeometry x="380" y="615" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-results" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#000000;align=left;spacingLeft=8;" value="&lt;b&gt;GET&lt;/b&gt; /analyze/results/{user_id}" vertex="1">
          <mxGeometry x="380" y="650" width="200" height="28" as="geometry" />
        </mxCell>

        <!-- ===== RIGHT: Backend Services (x center=850) ===== -->
        <mxCell id="svc-label" parent="1" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=13;fontStyle=1;" value="Backend Services" vertex="1">
          <mxGeometry x="730" y="20" width="200" height="25" as="geometry" />

        <!-- / (Home) → GET /courses -->
        <mxCell id="f3" edge="1" parent="1" source="fe-home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="gw-courses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- /search → courses + search + options -->
        <mxCell id="f4" edge="1" parent="1" source="fe-search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="gw-search">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- /explore → POST /chat -->
        <mxCell id="f5" edge="1" parent="1" source="fe-explore" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="gw-chat">
          <mxGeometry relative="1" as="geometry" />

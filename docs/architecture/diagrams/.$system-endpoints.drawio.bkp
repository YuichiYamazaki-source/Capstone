        </mxCell>

        <mxCell id="fe-onboarding" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#000000;fontStyle=1;" value="/onboarding" vertex="1">
          <mxGeometry x="60" y="140" width="140" height="35" as="geometry" />

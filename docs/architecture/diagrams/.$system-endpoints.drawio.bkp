        </mxCell>

        <mxCell id="fe-explore" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#000000;fontStyle=1;" value="/explore (Chat)" vertex="1">
          <mxGeometry x="60" y="350" width="140" height="35" as="geometry" />
        </mxCell>

        <mxCell id="fe-analysis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#000000;fontStyle=1;" value="/analysis" vertex="1">
          <mxGeometry x="60" y="420" width="140" height="35" as="geometry" />
        </mxCell>

        <mxCell id="fe-profile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#000000;fontStyle=1;" value="/profile" vertex="1">
          <mxGeometry x="60" y="490" width="140" height="35" as="geometry" />
        </mxCell>

        <!-- ===== CENTER: Gateway (x center=520) ===== -->
        <mxCell id="gw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=14;fontColor=#000000;fontStyle=1;" value="API Gateway :8000&lt;br&gt;&lt;font style=&quot;font-weight:normal;font-size:10px&quot;&gt;/api/v1 · JWT validation · route dispatch&lt;/font&gt;" vertex="1">
          <mxGeometry x="370" y="20" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- Gateway endpoints grouped by service color -->

        <!-- User Service endpoints (purple) -->
        <mxCell id="gw-register" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=11;fontColor=#000000;align=left;spacingLeft=8;" value="&lt;b&gt;POST&lt;/b&gt; /auth/register" vertex="1">
          <mxGeometry x="380" y="100" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-login" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=11;fontColor=#000000;align=left;spacingLeft=8;" value="&lt;b&gt;POST&lt;/b&gt; /auth/login" vertex="1">

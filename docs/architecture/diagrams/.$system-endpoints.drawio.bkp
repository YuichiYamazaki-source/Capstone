        <mxCell id="f1" edge="1" parent="1" source="fe-login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="gw-register">
          <mxGeometry relative="1" as="geometry" />

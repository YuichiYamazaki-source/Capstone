          <mxGeometry x="380" y="205" width="200" height="28" as="geometry" />
        </mxCell>

        <!-- Course Service endpoints (yellow) -->
        <mxCell id="gw-courses" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#000000;align=left;spacingLeft=8;" value="&lt;b&gt;GET&lt;/b&gt; /courses" vertex="1">
          <mxGeometry x="380" y="270" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-search" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#000000;align=left;spacingLeft=8;" value="&lt;b&gt;GET&lt;/b&gt; /courses/search?q=" vertex="1">
          <mxGeometry x="380" y="305" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-course-id" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#000000;align=left;spacingLeft=8;" value="&lt;b&gt;GET&lt;/b&gt; /courses/{id}" vertex="1">
          <mxGeometry x="380" y="340" width="200" height="28" as="geometry" />

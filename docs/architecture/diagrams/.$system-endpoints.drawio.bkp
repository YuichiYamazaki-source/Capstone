        <mxCell id="course-svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontColor=#000000;fontStyle=1;" value="Course Service :8001&lt;br&gt;&lt;font style=&quot;font-weight:normal;font-size:10px&quot;&gt;Course CRUD + Search + Filters&lt;br&gt;MongoDB courses collection&lt;/font&gt;" vertex="1">

        <!-- Green endpoints → AI Service -->
        <mxCell id="s5" edge="1" parent="1" source="gw-chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" target="ai-svc">

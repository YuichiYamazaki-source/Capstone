          <mxGeometry x="680" y="130" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Row 2: Entity Extractor -->
        <mxCell id="r2-comp" value="&lt;b&gt;Entity Extractor&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ccc;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2-v1" value="&lt;b&gt;LLM (GPT-4o-mini)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Structured output (JSON)&lt;br&gt;~200ms | ~$0.0003/req&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2-v2" value="&lt;b&gt;+ Response cache&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Cache frequent patterns&lt;br&gt;Hit: &amp;lt;5ms | Miss: same&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="200" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2-v3" value="&lt;font color=&quot;#999&quot;&gt;Same as V2&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ccc;" vertex="1" parent="1">
          <mxGeometry x="680" y="200" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Row 3: Intent Classifier -->
        <mxCell id="r3-comp" value="&lt;b&gt;Intent Classifier&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ccc;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r3-v1" value="&lt;b&gt;LLM (GPT-4o-mini)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Multi-label classification&lt;br&gt;~100ms | ~$0.0002/req&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="270" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r3-v2" value="&lt;b&gt;Fine-tuned classifier / SLM&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Distilled from V1 data&lt;br&gt;~5ms | ~$0 (local)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="270" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r3-v3" value="&lt;b&gt;+ Fallback chain&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;SLM → LLM → keyword rules&lt;br&gt;Guaranteed response&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="270" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Row 4: Query Decomposer -->
        <mxCell id="r4-comp" value="&lt;b&gt;Query Decomposer&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ccc;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r4-v1" value="&lt;b&gt;LLM (GPT-4o-mini)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Skip for simple queries&lt;br&gt;~300ms | ~$0.0005/req&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="340" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r4-v2" value="&lt;b&gt;+ Learned patterns&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Template-based for known patterns&lt;br&gt;LLM only for novel queries&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="340" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r4-v3" value="&lt;font color=&quot;#999&quot;&gt;Same as V2&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ccc;" vertex="1" parent="1">
          <mxGeometry x="680" y="340" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Row 5: Retrieval -->
        <mxCell id="r5-comp" value="&lt;b&gt;Course Retrieval&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ccc;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r5-v1" value="&lt;b&gt;Hybrid: Vector + Keyword&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;RRF score fusion&lt;br&gt;~100ms | ~$0.0001 (embed)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="410" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r5-v2" value="&lt;b&gt;+ Cross-encoder rerank&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;ms-marco-MiniLM-L-6-v2&lt;br&gt;+50ms | $0 (local model)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="410" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r5-v3" value="&lt;b&gt;+ Fallback chain&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Qdrant → keyword → cached&lt;br&gt;Guaranteed results&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="410" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Row 6: Agent Reasoning -->
        <mxCell id="r6-comp" value="&lt;b&gt;Agent Reasoning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(SGA, LPPA, CAA)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ccc;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r6-v1" value="&lt;b&gt;LLM (GPT-4o)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Full reasoning per agent&lt;br&gt;~500-800ms | ~$0.005/agent&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="480" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r6-v2" value="&lt;b&gt;GPT-4o + prompt tuning&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Optimized prompts, fewer tokens&lt;br&gt;Token usage tracked via LangFuse&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="480" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r6-v3" value="&lt;b&gt;+ Local fallback (Flan-T5)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Degraded but functional&lt;br&gt;if OpenAI is down&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="480" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Row 7: Response Generation -->
        <mxCell id="r7-comp" value="&lt;b&gt;Response Gen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(Learning Advisor)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ccc;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r7-v1" value="&lt;b&gt;LLM (GPT-4o)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Synthesize all agent outputs&lt;br&gt;~400ms | ~$0.003/req&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="550" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r7-v2" value="&lt;b&gt;+ Streaming&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;SSE streaming response&lt;br&gt;TTFB ~200ms&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="550" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r7-v3" value="&lt;b&gt;+ Guardrail validation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Content safety check&lt;br&gt;Prerequisite validation&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="550" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Row 8: Guardrails -->
        <mxCell id="r8-comp" value="&lt;b&gt;Guardrails&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ccc;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r8-v1" value="&lt;b&gt;Rule-based&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Input length, topic scope&lt;br&gt;&amp;lt;5ms | $0&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="620" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r8-v2" value="&lt;b&gt;Rule + heuristic&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;+ Output relevance check&lt;br&gt;+ Prerequisite validation&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="620" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r8-v3" value="&lt;b&gt;+ LLM-as-Judge&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Content appropriateness&lt;br&gt;CI/CD gate thresholds&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="620" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ========== COST SUMMARY ========== -->
        <mxCell id="cost-title" value="&lt;b style=&quot;font-size:14px&quot;&gt;Per-Query Cost &amp; Latency Estimate&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="720" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="cost-simple" value="&lt;div style=&quot;text-align:left;padding:10px&quot;&gt;&#xa;&lt;b style=&quot;font-size:13px&quot;&gt;Simple Query&lt;/b&gt; (single intent)&lt;br&gt;&#xa;&lt;i&gt;&quot;machine learning courses&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;V1:&lt;/b&gt; ~1.0s | ~$0.004&lt;br&gt;&#xa;Normalize → Entity → Intent → RA → LA&lt;br&gt;(skip Decomposer)&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;V2:&lt;/b&gt; ~0.6s | ~$0.003&lt;br&gt;&#xa;SLM intent + cache hits&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;V3:&lt;/b&gt; ~0.6s | ~$0.003&lt;br&gt;&#xa;Same + fallback ready&#xa;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="cost-complex" value="&lt;div style=&quot;text-align:left;padding:10px&quot;&gt;&#xa;&lt;b style=&quot;font-size:13px&quot;&gt;Complex Query&lt;/b&gt; (multi-intent)&lt;br&gt;&#xa;&lt;i&gt;&quot;Google AI Engineer, 6 months, LLM R&amp;D...&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;V1:&lt;/b&gt; ~2.9s | ~$0.02&lt;br&gt;&#xa;All 5 steps + 4 agents + LA&lt;br&gt;(CAA ∥ SGA parallelized)&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;V2:&lt;/b&gt; ~2.2s | ~$0.015&lt;br&gt;&#xa;SLM intent + prompt optimization&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;V3:&lt;/b&gt; ~2.2s | ~$0.015&lt;br&gt;&#xa;Same + guardrail validation&#xa;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="760" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="cost-ambiguous" value="&lt;div style=&quot;text-align:left;padding:10px&quot;&gt;&#xa;&lt;b style=&quot;font-size:13px&quot;&gt;Ambiguous Query&lt;/b&gt;&lt;br&gt;&#xa;&lt;i&gt;&quot;何から学習したらいいかわからない&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;V1:&lt;/b&gt; ~0.4s | ~$0.001&lt;br&gt;&#xa;Normalize → Entity → Intent&lt;br&gt;→ ambiguity &amp;gt; 0.7 → clarifying Q&lt;br&gt;(no agent dispatch)&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;V2:&lt;/b&gt; ~0.2s | ~$0.0005&lt;br&gt;&#xa;SLM detects ambiguity faster&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;V3:&lt;/b&gt; same as V2&#xa;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="720" y="760" width="300" height="200" as="geometry" />
        </mxCell>

        <!-- ========== PHASE MAPPING ========== -->
        <mxCell id="phase-title" value="&lt;b style=&quot;font-size:14px&quot;&gt;Phase Mapping Summary&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="990" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="phase3-box" value="&lt;div style=&quot;text-align:left;padding:10px&quot;&gt;&#xa;&lt;b style=&quot;font-size:13px;color:#82b366&quot;&gt;Phase 3 — Make it work&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#xa;✅ Query Understanding pipeline (all LLM-based)&lt;br&gt;&#xa;✅ 5 Agents with OpenAI Agents SDK&lt;br&gt;&#xa;✅ MCP Tool layer (5 tools)&lt;br&gt;&#xa;✅ Hybrid retrieval (vector + keyword + RRF)&lt;br&gt;&#xa;✅ Rule-based guardrails (input validation)&lt;br&gt;&#xa;✅ Basic DAG execution planner&lt;br&gt;&#xa;✅ End-to-end chat flow&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;Exit:&lt;/b&gt; User can chat → get AI recommendations&#xa;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="280" height="200" as="geometry" />
        </mxCell>

        <mxCell id="phase4-box" value="&lt;div style=&quot;text-align:left;padding:10px&quot;&gt;&#xa;&lt;b style=&quot;font-size:13px;color:#d6b656&quot;&gt;Phase 4 — Make it right&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#xa;📊 LangFuse + Arize Phoenix integration&lt;br&gt;&#xa;📊 Cross-encoder reranker&lt;br&gt;&#xa;📊 Intent classifier → SLM distillation&lt;br&gt;&#xa;📊 Prompt optimization (token reduction)&lt;br&gt;&#xa;📊 Response streaming (SSE)&lt;br&gt;&#xa;📊 DeepEval offline evaluation&lt;br&gt;&#xa;📊 Ground truth dataset curation&lt;br&gt;&#xa;📊 Full data (6,645 courses)&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;Exit:&lt;/b&gt; Quantified metrics + improvement evidence&#xa;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="360" y="1030" width="280" height="200" as="geometry" />
        </mxCell>

        <mxCell id="phase5-box" value="&lt;div style=&quot;text-align:left;padding:10px&quot;&gt;&#xa;&lt;b style=&quot;font-size:13px;color:#b85450&quot;&gt;Phase 5 — Make it safe&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#xa;🛡 Local embedding fallback (MiniLM)&lt;br&gt;&#xa;🛡 Local LLM fallback (Flan-T5)&lt;br&gt;&#xa;🛡 Qdrant → keyword fallback chain&lt;br&gt;&#xa;🛡 Circuit breaker + retry logic&lt;br&gt;&#xa;🛡 LLM-as-Judge guardrails&lt;br&gt;&#xa;🛡 Intent classifier fallback chain&lt;br&gt;&#xa;🛡 CI/CD quality gates&lt;br&gt;&#xa;🛡 Load testing (Locust)&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;Exit:&lt;/b&gt; Graceful degradation under any failure&#xa;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1">
          <mxGeometry x="680" y="1030" width="280" height="200" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

          <mxGeometry x="40" y="130" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r1-v1" value="&lt;b&gt;Rule-based&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;Regex, strip, lang detect&lt;br&gt;&amp;lt;5ms | $0&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="130" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r1-v2" value="&lt;b&gt;+ Multi-modal adapter&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;STT (Whisper), OCR&lt;br&gt;+200ms | ~$0.006/min audio&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="240" height="60" as="geometry" />
        </mxCell>
